{
  // Config Cloudflare Worker — source of truth. L'adapter Astro la legge a build
  // time e scrive il config deployabile in `dist/server/wrangler.json` (il sito ha
  // una route server: /api/richiesta). Deploy con `npm run deploy` (docs/deploy.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "viosadea",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // URL *.workers.dev per testare prima del cutover del dominio.
  "workers_dev": true,

  // Domini custom: scommentare SOLO quando la zona viosadea.com è Active su
  // Cloudflare (vedi docs/dns-migration.md). Prima, il deploy fallirebbe.
  // "routes": [
  //   { "pattern": "www.viosadea.com", "custom_domain": true },
  //   { "pattern": "viosadea.com", "custom_domain": true }
  // ],

  // Variabili non segrete del modulo richieste (/api/richiesta), inviato con Brevo.
  // MAIL_FROM deve appartenere a un dominio autenticato su Brevo (viosadea.com).
  // I segreti si impostano sul Worker, mai qui:
  //   npm run cf:secret:brevo       (BREVO_API_KEY)
  //   npm run cf:secret:turnstile   (TURNSTILE_SECRET)
  // In locale: .dev.vars (vedi .dev.vars.example). La site key pubblica di
  // Turnstile sta in src/consts.ts (le pagine sono statiche).
  "vars": {
    "CONTACT_TO": "viosadea@gmail.com",
    "MAIL_FROM": "no-reply@viosadea.com"
  },

  "observability": {
    "enabled": true
  }
}
