---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getCopy } from '../content';
import type { Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = getCopy(locale);
const p = copy.privacy;
---

<Base title={copy.meta.privacy.title} description={copy.meta.privacy.description} locale={locale} pageKey="privacy">
  <PageHeader locale={locale} pageKey="privacy" title={p.title} subtitle={p.updated} />
  <section class="section">
    <div class="container prose">
      {
        p.sections.map((s) => (
          <>
            <h2>{s.title}</h2>
            {s.body.map((para) => <p>{para}</p>)}
          </>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .prose h2 { font-size: clamp(1.3rem, 4vw, 1.6rem); }
  .prose h2:first-child { margin-top: 0; }
</style>
