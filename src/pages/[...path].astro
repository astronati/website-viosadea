---
// Unica rotta per tutte le pagine in tutte le lingue: la tabella src/i18n/routes.ts
// genera /appartamento, /de/ferienwohnung, /ru/kontakty, ecc.
import type { GetStaticPaths } from 'astro';
import { LOCALES, type Locale } from '../i18n/locales';
import { PAGE_KEYS, paramFor, type PageKey } from '../i18n/routes';
import HomePage from '../views/HomePage.astro';
import ApartmentPage from '../views/ApartmentPage.astro';
import GalleryPage from '../views/GalleryPage.astro';
import LocationPage from '../views/LocationPage.astro';
import ContactPage from '../views/ContactPage.astro';
import PrivacyPage from '../views/PrivacyPage.astro';

export const getStaticPaths = (() =>
  LOCALES.flatMap((locale) =>
    PAGE_KEYS.map((key) => ({ params: { path: paramFor(key, locale) }, props: { key, locale } })),
  )) satisfies GetStaticPaths;

interface Props {
  key: PageKey;
  locale: Locale;
}

const VIEWS = {
  home: HomePage,
  apartment: ApartmentPage,
  gallery: GalleryPage,
  location: LocationPage,
  contact: ContactPage,
  privacy: PrivacyPage,
} satisfies Record<PageKey, unknown>;

const { key, locale } = Astro.props;
const View = VIEWS[key];
---

<View locale={locale} />
