---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCTA from '../components/StickyCTA.astro';
import { SITE } from '../consts';
import type { Locale } from '../i18n/locales';
import type { PageKey } from '../i18n/routes';
import { useTranslations } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /** chiave della pagina: abilita canonical localizzato, hreflang e selettore lingua */
  pageKey?: PageKey;
  image?: ImageMetadata;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { locale, pageKey } = Astro.props;
const t = useTranslations(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead {...Astro.props} />
  </head>
  <body>
    <a href="#main" class="skip-link">{t('a11y.skip')}</a>
    <Header locale={locale} pageKey={pageKey} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} pageKey={pageKey} />
    <StickyCTA locale={locale} pageKey={pageKey} />
    {
      SITE.cfBeaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: SITE.cfBeaconToken })}
        />
      )
    }
  </body>
</html>
