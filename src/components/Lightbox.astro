---
// Lightbox condivisa: apre i link <a data-lightbox="gruppo" href="foto-grande">.
// Senza JS i link aprono semplicemente l'immagine. Swipe, frecce e Esc.
import Icon from './Icon.astro';
import type { Locale } from '../i18n/locales';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
}
const t = useTranslations(Astro.props.locale);
---

<dialog id="lightbox" class="lightbox" aria-label={t('gallery.open')}>
  <button type="button" class="lb-btn lb-close" data-lb="close" aria-label={t('gallery.close')}>
    <Icon name="close" />
  </button>
  <figure>
    <img alt="" decoding="async" />
    <figcaption><span class="lb-caption"></span> <span class="lb-count"></span></figcaption>
  </figure>
  <button type="button" class="lb-btn lb-prev" data-lb="prev" aria-label={t('gallery.prev')}>
    <Icon name="left" />
  </button>
  <button type="button" class="lb-btn lb-next" data-lb="next" aria-label={t('gallery.next')}>
    <Icon name="right" />
  </button>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (dialog) {
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector('.lb-caption')!;
    const count = dialog.querySelector('.lb-count')!;
    let group: HTMLAnchorElement[] = [];
    let index = 0;

    const show = (i: number) => {
      index = (i + group.length) % group.length;
      const link = group[index];
      img.src = link.href;
      img.alt = link.dataset.alt ?? '';
      caption.textContent = link.dataset.caption ?? '';
      count.textContent = group.length > 1 ? `${index + 1} / ${group.length}` : '';
      // precarica la successiva
      const next = group[(index + 1) % group.length];
      if (next) new Image().src = next.href;
    };

    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-lightbox]');
      if (!link || e.metaKey || e.ctrlKey) return;
      e.preventDefault();
      group = Array.from(
        document.querySelectorAll<HTMLAnchorElement>(`a[data-lightbox="${link.dataset.lightbox}"]`),
      ).filter((a) => !a.closest('[hidden]'));
      show(group.indexOf(link));
      dialog.showModal();
    });

    dialog.addEventListener('click', (e) => {
      const action = (e.target as HTMLElement).closest<HTMLElement>('[data-lb]')?.dataset.lb;
      if (action === 'close' || e.target === dialog) dialog.close();
      else if (action === 'prev') show(index - 1);
      else if (action === 'next') show(index + 1);
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('close', () => img.removeAttribute('src'));

    let startX = 0;
    dialog.addEventListener('pointerdown', (e) => (startX = e.clientX));
    dialog.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(18, 13, 9, 0.96);
    color: #fff;
    touch-action: pan-y;
  }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: rgba(18, 13, 9, 0.9); }
  :global(html:has(dialog[open])) { overflow: hidden; }
  figure { margin: 0; display: grid; gap: 0.6rem; justify-items: center; padding: 3.5rem 0.5rem 5rem; }
  img {
    max-width: min(96vw, 1600px);
    max-height: calc(100dvh - 9rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    user-select: none;
    -webkit-user-drag: none;
  }
  figcaption { font-size: 0.9rem; color: #e7ddd0; text-align: center; }
  .lb-count { opacity: 0.7; margin-left: 0.4rem; }
  .lb-btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    cursor: pointer;
  }
  .lb-btn:hover { background: rgba(255, 255, 255, 0.25); }
  .lb-close { top: max(0.75rem, env(safe-area-inset-top)); right: 0.75rem; }
  .lb-prev, .lb-next { bottom: calc(1rem + env(safe-area-inset-bottom)); }
  .lb-prev { left: calc(50% - 60px); }
  .lb-next { right: calc(50% - 60px); }
  @media (min-width: 960px) {
    .lb-prev, .lb-next { top: 50%; bottom: auto; transform: translateY(-50%); }
    .lb-prev { left: 1.25rem; }
    .lb-next { right: 1.25rem; }
  }
</style>
