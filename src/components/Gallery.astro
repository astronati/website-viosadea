---
// Galleria con filtri per ambiente. Miniature quadrate, foto intera nella lightbox.
import { getImage } from 'astro:assets';
import Photo from './Photo.astro';
import { PHOTOS, ROOMS, type Photo as PhotoData } from '../data/gallery';
import type { Locale } from '../i18n/locales';
import { useTranslations, type UIKey } from '../i18n/utils';

interface Props {
  locale: Locale;
  photos?: PhotoData[];
  filters?: boolean;
}
const { locale, photos = PHOTOS, filters = true } = Astro.props;
const t = useTranslations(locale);

const fulls = await Promise.all(
  photos.map((p) => getImage({ src: p.src, width: Math.min(1920, p.src.width), format: 'webp' })),
);
const rooms = ROOMS.map((room) => ({ room, count: photos.filter((p) => p.room === room).length })).filter(
  (r) => r.count > 0,
);
---

<div class="gallery" data-gallery>
  {
    filters && (
      <div class="filters" role="group" aria-label={t('nav.gallery')}>
        <button type="button" data-filter="all" aria-pressed="true">
          {t('gallery.all')} <span>{photos.length}</span>
        </button>
        {rooms.map((r) => (
          <button type="button" data-filter={r.room} aria-pressed="false">
            {t(`room.${r.room}` as UIKey)} <span>{r.count}</span>
          </button>
        ))}
      </div>
    )
  }

  <ul class="grid-photos">
    {
      photos.map((p, i) => (
        <li data-room={p.room}>
          <a
            href={fulls[i].src}
            data-lightbox="gallery"
            data-alt={p.alt[locale]}
            data-caption={t(`room.${p.room}` as UIKey)}
            aria-label={`${t('gallery.open')}: ${p.alt[locale]}`}
          >
            <Photo
              photo={p}
              locale={locale}
              sizes="(min-width: 960px) 25vw, (min-width: 640px) 33vw, 50vw"
              widths={[320, 480, 640, 960]}
              loading={i < 4 ? 'eager' : 'lazy'}
            />
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const buttons = gallery.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = gallery.querySelectorAll<HTMLLIElement>('li[data-room]');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        items.forEach((li) => (li.hidden = !(filter === 'all' || li.dataset.room === filter)));
      }),
    );
  });
</script>

<style>
  .filters {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 0.25rem;
    margin: 0 calc(var(--gutter) * -1) 1.25rem;
    padding-inline: var(--gutter);
  }
  .filters::-webkit-scrollbar { display: none; }
  .filters button {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: 999px;
    border: 1px solid var(--c-line);
    background: var(--c-surface);
    color: var(--c-ink);
    font: 600 0.9rem var(--font-sans);
    cursor: pointer;
  }
  .filters button span { font-size: 0.75rem; color: var(--c-ink-soft); }
  .filters button[aria-pressed='true'] { background: var(--c-brown); border-color: var(--c-brown); color: #fff; }
  .filters button[aria-pressed='true'] span { color: #f3dcc0; }

  .grid-photos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .grid-photos li:first-child:not([hidden]) { grid-column: span 2; }
  .grid-photos a { display: block; border-radius: var(--radius-sm); overflow: hidden; background: var(--c-bg-alt); }
  .grid-photos :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .grid-photos li:first-child :global(img) { aspect-ratio: 4 / 3; }
  .grid-photos a:hover :global(img) { transform: scale(1.04); }

  @media (min-width: 640px) {
    .filters { flex-wrap: wrap; overflow: visible; margin-inline: 0; padding-inline: 0; }
    .grid-photos { grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
    .grid-photos li:first-child:not([hidden]) { grid-column: span 2; grid-row: span 2; }
    .grid-photos li:first-child :global(img) { aspect-ratio: 1; height: 100%; }
  }
  @media (min-width: 960px) { .grid-photos { grid-template-columns: repeat(4, 1fr); } }
</style>
