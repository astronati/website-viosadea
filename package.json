{
  "name": "viosadea",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Sito di Cèsa Viosadea – appartamento a Campitello di Fassa (Dolomiti), pet friendly con parcheggio privato",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro build && wrangler dev --config dist/server/wrangler.json",
    "astro": "astro",
    "deploy": "astro build && wrangler deploy --config dist/server/wrangler.json",
    "deploy:dry": "astro build && wrangler deploy --config dist/server/wrangler.json --dry-run",
    "cf:whoami": "wrangler whoami",
    "cf:secret:turnstile": "wrangler secret put TURNSTILE_SECRET --name viosadea",
    "cf:secret:brevo": "wrangler secret put BREVO_API_KEY --name viosadea",
    "cf:logs": "wrangler tail viosadea",
    "cf:deployments": "wrangler deployments list --name viosadea",
    "import:photos": "node scripts/import-wp-media.mjs",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.3",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/manrope": "^5.2.8",
    "astro": "^7.1.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.112.0"
  }
}
